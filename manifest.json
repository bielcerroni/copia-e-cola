{
  "manifest_version": 3,
  "name": "Copia & Cola — anexos rápidos",
  "short_name": "Copia & Cola",
  "version": "0.1.2",
  "description": "Anexe imagens da área de transferência e downloads recentes sem procurar em pastas.",
  "permissions": [
    "downloads",
    "storage",
    "clipboardRead",
    "offscreen"
  ],
  "host_permissions": [
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "116"
}
